# Copiar a .env y rellenar. .env está en .gitignore.

# Clave de Google Books (opcional). Sin ella la cuota es ~100 peticiones/día.
GOOGLE_BOOKS_API_KEY=

# Puerto del host donde se publica la app.
APP_PORT=8000

# Interfaz del host donde se publica el puerto. Por defecto 127.0.0.1: solo
# accesible desde esta máquina. Pon 0.0.0.0 para exponerla en la red local
# (ojo: la app no tiene autenticación).
APP_BIND=127.0.0.1

# Directorio del host con la base de datos (library.db). Debe existir antes de
# arrancar y pertenecer a PUID:PGID; si no, Docker lo crea como root.
LIBRARY_DATA_DIR=./data

# Usuario/grupo con el que corre el contenedor (normalmente `id -u` / `id -g`).
PUID=1000
PGID=1000
